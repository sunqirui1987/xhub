    "cache_consistency": {
      "identical_replays": 2,
      "cross_key_isolation": true,
      "route_change_invalidates": true,
      "cache_hit_cost": 0
    },
    "weighted_route_switch": {
      "initial_weights": [
        100,
        0
      ],
      "updated_weights": [
        0,
        100
      ]
    },
    "fallback_cache": {
      "primary_failure_status": 429,
      "repeat_requests": 2,
      "cache_must_remain_disabled": true
    }
  },
  "guardrails": [
    {
      "guardrail_name": "手机号脱敏",
      "litellm_params": {
        "guardrail": "local",
        "mode": "pre_call",
        "default_on": true,
        "priority": 10,
        "patterns": [
          "1[3-9][0-9]{9}"
        ],
        "action": "redact",
        "replacement": "[手机号已隐藏]"
      }
    },
    {
      "guardrail_name": "邮箱脱敏",
      "litellm_params": {
        "guardrail": "local",
        "mode": "pre_call",
        "default_on": true,
        "priority": 20,
        "patterns": [
          "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}"
        ],
        "action": "redact",
        "replacement": "[邮箱已隐藏]"
      }
    },
    {
      "guardrail_name": "敏感内容拦截",
      "litellm_params": {
        "guardrail": "local",
        "mode": "pre_call",
        "default_on": true,
        "priority": 30,
        "blocked_words": [
          "验收禁止外发"
        ],
        "action": "block"
      }
    },
    {
      "guardrail_name": "XGo-敏感信息拦截",
      "litellm_params": {
        "guardrail": "custom_code",
        "custom_code_language": "xgo",
        "custom_code": "import . \"xhub/guardrail\"\nfunc ApplyGuardrail(texts []string, requestData map[string]any, inputType string) map[string]any {\n // 仅允许请求阶段，按文本检查敏感测试标记。\n if inputType != \"request\" { return Block(\"unexpected input type\") }\n for text <- texts { if Contains(text, \"XGO_SECRET\") { return Block(\"验收敏感信息禁止外发\") } }\n return Allow()\n}",
        "mode": "pre_call",
        "default_on": false,
        "priority": 40
      },
      "acceptance": {
        "text": "XGO_SECRET",
        "action": "block",
        "expected_http_status": 400,
        "replacement": null
      }
    },
    {
      "guardrail_name": "XGo-工单脱敏",
      "litellm_params": {
        "guardrail": "custom_code",
        "custom_code_language": "xgo",
        "custom_code": "import . \"xhub/guardrail\"\nfunc ApplyGuardrail(texts []string, requestData map[string]any, inputType string) map[string]any {\n // 修改文本后交给真实供应商，禁止原始标记外发。\n for i, text := range texts { texts[i] = RegexReplace(text, \"XGO_PRIVATE\", \"[工单已隐藏]\") }\n return Modify(texts)\n}",
        "mode": "pre_call",
        "default_on": false,
        "priority": 40
      },
      "acceptance": {
        "text": "XGO_PRIVATE",
        "action": "modify",
        "expected_http_status": 200,
        "replacement": "[工单已隐藏]"
      }
    },
    {
      "guardrail_name": "XGo-审计标记",
      "litellm_params": {
        "guardrail": "custom_code",
        "custom_code_language": "xgo",
        "custom_code": "import . \"xhub/guardrail\"\nfunc ApplyGuardrail(texts []string, requestData map[string]any, inputType string) map[string]any {\n // 审计标记保留业务可用性，真实模型继续处理。\n for text <- texts { if Contains(text, \"XGO_REVIEW\") { return Flag(\"人工复核\", map[string]any{\"category\":\"acceptance-review\"}) } }\n return Allow()\n}",
        "mode": "pre_call",
        "default_on": false,
        "priority": 40
      },
      "acceptance": {
        "text": "XGO_REVIEW",
        "action": "flag",
        "expected_http_status": 200,
        "replacement": null
      }
    }
  ],
